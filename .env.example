# ===== Agri-Advisor environment =====
# Copy this file to .env for local development:
#   cp .env.example .env
#
# REQUIRED — the server refuses to start without it:
# Long random string that signs auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OPTIONAL — port the server listens on (default 3000).
# The hosting platform usually sets this for you.
# PORT=3000

# OPTIONAL — set to "production" on deployed instances.
# NODE_ENV=development

# OPTIONAL — redirect stray HTTP to HTTPS (requires a TLS-terminating
# proxy/platform, e.g. Render/Railway managed certificates).
# FORCE_HTTPS=false

# OPTIONAL — SQLite file location (default: db/agri.db). On a hosted
# platform, point this at a persistent volume, e.g. /data/agri.db
# DB_PATH=db/agri.db

# OPTIONAL — enables AI-generated advice via the Claude API. When unset
# (or on API failure) advice falls back to the built-in template generator.
# ANTHROPIC_API_KEY=
