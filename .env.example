# Copy this file to .env and fill in real values before running the server.

# Required — used to sign auth tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Optional
PORT=3000
JWT_EXPIRES_IN=2h
NODE_ENV=development

# Optional — if set, /api/advice uses the Claude API to write more
# conversational advice. If unset, advice is generated from templates
# using the Crops table fields (still fully functional).
ANTHROPIC_API_KEY=

# Set to true only when running behind a proxy that terminates TLS,
# to force-redirect any stray HTTP requests to HTTPS.
FORCE_HTTPS=false
